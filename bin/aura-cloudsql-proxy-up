#!/usr/bin/env bash
# Sobe o Cloud SQL Auth Proxy oficial do Google para o MySQL compartilhado do Aura, em tmux,
# escutando em 127.0.0.1:13306 — a mesma porta que a configuração local (Infisical/.aura-env)
# já usa. Substitui o antigo túnel via proxy HTTP CONNECT (aposentado em 16/09/2026): a
# instância exige rede autorizada e o proxy HTTP ficou fora da lista; o Auth Proxy autentica
# pela identidade do gcloud (IAM) e dispensa allowlist de IP.
#
# Uso: aura-cloudsql-proxy-up [--session NOME] [--port PORTA] [--instance CONEXAO]
# Idempotente: se a porta já responde ao handshake do MySQL, apenas informa e sai.
# Pré-requisitos: gcloud autenticado (conta com papel Cloud SQL Client no projeto da instância)
# e o binário cloud-sql-proxy (instalado em ~/.local/bin; ver INSTALL abaixo).
set -euo pipefail

SESSION=aura-tunnels
WINDOW=sqlproxy
PORT=13306
INSTANCE="aitrus-shared-prod:us-central1:shared"
BIN="${CLOUD_SQL_PROXY_BIN:-$HOME/.local/bin/cloud-sql-proxy}"
INSTALL="curl -fsSL -o ~/.local/bin/cloud-sql-proxy https://storage.googleapis.com/cloud-sql-connectors/cloud-sql-proxy/v2.25.4/cloud-sql-proxy.linux.amd64 && chmod +x ~/.local/bin/cloud-sql-proxy"

while [ $# -gt 0 ]; do
  case "$1" in
    --session) SESSION="$2"; shift 2 ;;
    --port) PORT="$2"; shift 2 ;;
    --instance) INSTANCE="$2"; shift 2 ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "argumento desconhecido: $1" >&2; exit 2 ;;
  esac
done

handshake_ok() {
  python3 - "$PORT" <<'PY'
import socket, sys
port = int(sys.argv[1])
try:
    s = socket.create_connection(("127.0.0.1", port), timeout=8)
    data = s.recv(64)
    s.close()
    sys.exit(0 if data and b"google" in data else 1)
except Exception:
    sys.exit(1)
PY
}

if handshake_ok; then
  echo "MySQL já responde em 127.0.0.1:$PORT (sessão tmux: $SESSION; attach: tmux attach -t $SESSION)"
  exit 0
fi

if ss -ltn | grep -q "127.0.0.1:$PORT "; then
  echo "ERRO: algo escuta em 127.0.0.1:$PORT mas não é o MySQL do Google (túnel antigo?). Pare-o antes." >&2
  exit 1
fi

if [ ! -x "$BIN" ]; then
  echo "ERRO: cloud-sql-proxy ausente em $BIN. Instale com:" >&2
  echo "  $INSTALL" >&2
  exit 1
fi

ACCOUNT="$(gcloud auth list --filter=status:ACTIVE --format='value(account)' 2>/dev/null || true)"
if [ -z "$ACCOUNT" ]; then
  echo "ERRO: nenhuma conta ativa no gcloud. Execute: gcloud auth login" >&2
  exit 1
fi

tmux has-session -t "$SESSION" 2>/dev/null || tmux new-session -d -s "$SESSION" -c "$HOME"
if tmux list-windows -t "$SESSION" -F '#{window_name}' | grep -qx "$WINDOW"; then
  tmux kill-window -t "$SESSION:$WINDOW"
fi
tmux new-window -d -t "$SESSION" -n "$WINDOW" -c "$HOME" \
  "'$BIN' --gcloud-auth --address 127.0.0.1 --port '$PORT' '$INSTANCE'"

for _ in $(seq 1 20); do
  sleep 1
  if handshake_ok; then
    echo "Cloud SQL Auth Proxy ativo: $INSTANCE -> 127.0.0.1:$PORT (conta $ACCOUNT)"
    echo "sessão tmux: $SESSION, janela $WINDOW (attach: tmux attach -t $SESSION)"
    exit 0
  fi
done

echo "ERRO: o proxy não respondeu ao handshake em 20 s. Veja: tmux attach -t $SESSION" >&2
exit 1
