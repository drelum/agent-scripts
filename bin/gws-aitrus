#!/usr/bin/env bash
set -euo pipefail

unset GOOGLE_WORKSPACE_CLI_TOKEN
unset GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE
unset GOOGLE_APPLICATION_CREDENTIALS
unset GOOGLE_WORKSPACE_CLI_CLIENT_ID
unset GOOGLE_WORKSPACE_CLI_CLIENT_SECRET
unset GOOGLE_WORKSPACE_PROJECT_ID

export GOOGLE_WORKSPACE_CLI_CONFIG_DIR="$HOME/.config/gws-aitrus"

exec gws "$@"
