#!/usr/bin/env python3
from __future__ import annotations

import argparse
import math
import shlex
import sys
from pathlib import Path

from autoreview_lib.bundle import BundleError, build_bundle
from autoreview_lib.engines import (
    CODEX_SAFE_PROMPT_CHARS,
    DEFAULT_CODEX_MODEL,
    DEFAULT_HEARTBEAT_SECONDS,
    DEFAULT_OUTPUT_ROOT,
    DEFAULT_TIMEOUT_SECONDS,
    UNAVAILABLE_EVE_KIT_REFERENCE,
    EngineError,
    command_preview,
    load_eve_kit_reference,
    review_prompt,
    run_engine,
    validate_prompt_size,
)
from autoreview_lib.eve_detection import detect_eve
from autoreview_lib.eve_docs import (
    EveDocsError,
    refresh_eve_docs,
    snapshot_path_from_reference,
)
from autoreview_lib.follow_up import (
    FollowUpError,
    prepare_follow_up,
    write_run_context,
)
from autoreview_lib.report import ReportError, extract_report, render_markdown

DEFAULT_MAX_BUNDLE_KB = 960
UNAVAILABLE_EVE_DOCS_REFERENCE = '{"available":false,"fresh":false,"path":null,"sources":[]}'


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Isolated structured review with Codex or Claude.")
    parser.add_argument("--engine", choices=["codex", "claude"], default="codex")
    parser.add_argument("--mode", choices=["auto", "local", "branch", "commit"], default="auto")
    parser.add_argument("--base")
    parser.add_argument("--commit", default="HEAD")
    parser.add_argument(
        "--follow-up",
        type=Path,
        metavar="REPORT_OR_RUN_DIR",
        help="Verify an accepted finding using artifacts from one previous full review.",
    )
    parser.add_argument(
        "--accepted-finding",
        action="append",
        default=[],
        type=int,
        metavar="NUMBER",
        help="1-based finding number to verify; repeat when multiple findings were accepted.",
    )
    parser.add_argument(
        "--path",
        action="append",
        default=[],
        metavar="RELATIVE_PATH",
        help="Limit review to a repository-relative file or directory; repeat as needed.",
    )
    parser.add_argument(
        "--model",
        help=f"Optional engine model override; Codex defaults to {DEFAULT_CODEX_MODEL}, Claude to its CLI default.",
    )
    parser.add_argument(
        "--fast",
        action="store_true",
        help="Use Codex Fast service tier; valid only with --engine codex.",
    )
    parser.add_argument("--repo", type=Path, default=Path.cwd())
    parser.add_argument("--max-bundle-kb", type=int, default=DEFAULT_MAX_BUNDLE_KB)
    parser.add_argument("--timeout-seconds", type=positive_seconds, default=DEFAULT_TIMEOUT_SECONDS)
    parser.add_argument("--heartbeat-seconds", type=positive_seconds, default=DEFAULT_HEARTBEAT_SECONDS)
    parser.add_argument("--output-root", type=Path, default=DEFAULT_OUTPUT_ROOT)
    parser.add_argument(
        "--stream-engine-output",
        action="store_true",
        help="Emit additional filtered engine activity to stderr; raw events remain in the run log.",
    )
    parser.add_argument("--dry-run", action="store_true", help="Build and screen the bundle without invoking a model.")
    args = parser.parse_args()
    if args.fast and args.engine != "codex":
        parser.error("--fast is valid only with --engine codex")
    if args.accepted_finding and not args.follow_up:
        parser.error("--accepted-finding requires --follow-up")
    return args


def positive_seconds(value: str) -> float:
    try:
        seconds = float(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("must be a number") from error
    if not math.isfinite(seconds) or seconds <= 0:
        raise argparse.ArgumentTypeError("must be a finite number greater than zero")
    return seconds


def main() -> int:
    args = parse_args()
    repo = args.repo.resolve()
    try:
        bundle = build_bundle(
            repo=repo,
            mode=args.mode,
            base=args.base,
            commit=args.commit,
            max_bundle_bytes=args.max_bundle_kb * 1024,
            paths=args.path,
        )
        eve_detected = detect_eve(repo, bundle.content)
        # O follow-up compara com o Eve Kit atual sempre que a revisão completa detectou EVE.
        eve_kit_reference = (
            load_eve_kit_reference()
            if eve_detected or args.follow_up
            else UNAVAILABLE_EVE_KIT_REFERENCE
        )
        follow_up = None
        if args.follow_up:
            follow_up = prepare_follow_up(
                args.follow_up,
                repo=repo,
                engine=args.engine,
                target=bundle.label,
                current_review_identity=bundle.identity,
                current_bundle=bundle.content,
                current_eve_kit_reference=eve_kit_reference,
                accepted_findings=args.accepted_finding,
            )
            prompt = follow_up.prompt
            eve_docs_reference = follow_up.eve_docs_reference
            eve_detected = follow_up.eve_detected
        elif not eve_detected:
            eve_docs_reference = UNAVAILABLE_EVE_DOCS_REFERENCE
            prompt = review_prompt(bundle.label, bundle.content, eve_detected=False)
        else:
            eve_docs = refresh_eve_docs()
            eve_docs_reference = eve_docs.reference
            if eve_docs.warning:
                print(
                    f"autoreview: EVE documentation snapshot warning: {eve_docs.warning}",
                    file=sys.stderr,
                    flush=True,
                )
            prompt = review_prompt(
                bundle.label,
                bundle.content,
                eve_kit_reference,
                eve_docs_reference,
            )
        eve_docs_path = snapshot_path_from_reference(eve_docs_reference)
        prompt_size = validate_prompt_size(args.engine, prompt)
        if args.dry_run:
            preview = command_preview(
                args.engine,
                repo,
                args.model,
                args.fast,
                eve_docs_path,
                eve_detected,
            )
            print(
                "\n".join(
                    [
                        "Status: DRY-RUN",
                        "",
                        "# Escopo",
                        "",
                        f"- Tipo: {'follow-up' if follow_up else 'full'}",
                        f"- Alvo: {bundle.label}",
                        (
                            f"- Documentação EVE: {eve_docs_path or 'fallback web'}"
                            if eve_detected
                            else "- EVE: não detectado; snapshot e pesquisa omitidos"
                        ),
                        f"- Bundle: {len(bundle.content.encode('utf-8'))} bytes",
                        *(
                            [f"- Delta da correção: {len(follow_up.correction_delta.encode('utf-8'))} bytes"]
                            if follow_up
                            else []
                        ),
                        (
                            f"- Prompt: {prompt_size} / {CODEX_SAFE_PROMPT_CHARS} caracteres seguros"
                            if args.engine == "codex"
                            else f"- Prompt: {prompt_size} caracteres"
                        ),
                        "",
                        "# Comando",
                        "",
                        "```bash",
                        shlex.join(preview["command"]),
                        "```",
                    ]
                )
            )
            return 0
        run = run_engine(
            args.engine,
            repo,
            prompt,
            args.model,
            fast=args.fast,
            timeout_seconds=args.timeout_seconds,
            heartbeat_seconds=args.heartbeat_seconds,
            stream_engine_output=args.stream_engine_output,
            output_root=args.output_root,
            additional_read_path=eve_docs_path,
            eve_web_fallback=eve_detected,
            progress=lambda message: print(f"autoreview: {message}", file=sys.stderr, flush=True),
        )
        report = extract_report(run.result)
        report_file = run.run_dir / "report.md"
        rendered = render_markdown(
            report,
            engine=args.engine,
            target=bundle.label,
            duration_seconds=run.duration_seconds,
            report_file=str(report_file),
            review_type="follow-up" if follow_up else "full",
        )
        write_run_context(
            run.run_dir,
            repo=repo,
            engine=args.engine,
            target=bundle.label,
            review_identity=bundle.identity,
            bundle=bundle.content,
            report=report,
            review_type="follow-up" if follow_up else "full",
            eve_kit_reference=(
                follow_up.eve_kit_reference if follow_up else eve_kit_reference
            ),
            eve_docs_reference=eve_docs_reference,
            parent_run=follow_up.parent_run if follow_up else None,
            accepted_findings=follow_up.accepted_findings if follow_up else (),
        )
        report_file.write_text(rendered, encoding="utf-8")
        print(rendered, end="")
        findings = report["findings"]
        if findings:
            print(f"autoreview: {len(findings)} actionable finding(s)", file=sys.stderr)
            return 0
        print("autoreview clean: no actionable findings reported", file=sys.stderr)
        return 0
    except (
        BundleError,
        EngineError,
        EveDocsError,
        FollowUpError,
        ReportError,
        UnicodeDecodeError,
    ) as error:
        print(f"autoreview: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
