#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path

from autoreview_lib.eve_docs import DEFAULT_CACHE_ROOT, refresh_eve_docs


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Refresh the deterministic local snapshot of current official EVE documentation."
    )
    parser.add_argument("--cache-dir", type=Path, default=DEFAULT_CACHE_ROOT)
    parser.add_argument("--offline", action="store_true", help="Return the current snapshot without network access.")
    parser.add_argument("--json", action="store_true", help="Print snapshot metadata as JSON.")
    args = parser.parse_args()
    snapshot = refresh_eve_docs(args.cache_dir, offline=args.offline)
    if args.json:
        print(snapshot.reference)
    elif snapshot.path:
        print(snapshot.path)
    else:
        print(snapshot.warning or "EVE documentation snapshot unavailable")
    return 0 if snapshot.path else 2


if __name__ == "__main__":
    raise SystemExit(main())
