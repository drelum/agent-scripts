#!/usr/bin/env bash
# Lista o que chegou a produção desde a última novidade: commits na branch prod do aura e do aura-ui.
# Uso: aura-novidades-pendentes [AAAA-MM-DD]   (padrão: data da entrada mais recente)
# Novidades: AURA_NOVIDADES_ROOT (padrão ~/Projects/context/aitrus/novidades).
# Repositórios: AURA_ROOT (~/Projects/aura) e AURA_UI_ROOT (~/Projects/aura-ui); lê origin/prod.
set -euo pipefail
nov="${AURA_NOVIDADES_ROOT:-$HOME/Projects/context/aitrus/novidades}"
aura="${AURA_ROOT:-$HOME/Projects/aura}"
aura_ui="${AURA_UI_ROOT:-$HOME/Projects/aura-ui}"

ultimo="$(ls "$nov"/entradas/*.md 2>/dev/null | sed 's|.*/||' | sort | tail -1 || true)"
desde="${1:-${ultimo:0:10}}"
[ -n "$desde" ] || desde="$(date -d '-30 days' +%F)"

echo "== Novidades publicadas (última: ${ultimo:-nenhuma})"
ls "$nov"/entradas/*.md 2>/dev/null | sed 's|.*/||; s|\.md$||' | sort -r | head -5

for repo in "$aura" "$aura_ui"; do
  git -C "$repo" fetch -q origin prod
  echo
  echo "== Em produção desde $desde: $(basename "$repo") (origin/prod)"
  # o que entrou na prod desde a data: alcançável hoje e não alcançável pela prod daquele dia
  antes="$(git -C "$repo" rev-list -1 --before="$desde 00:00" origin/prod)"
  git -C "$repo" log --no-merges --date=short --pretty='%ad %h %s' origin/prod ${antes:+"^$antes"} \
    | grep -vE 'chore\(|docs\(|ci\(|test\(|build\(|style\(|refactor\(' || true
done

echo
echo "== Próximo passo: para cada item com efeito visível ao gestor, ler o PR e o ticket (AITRUS-N no"
echo "   Linear) e criar uma entrada em $nov/entradas/."
