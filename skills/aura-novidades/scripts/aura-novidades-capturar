#!/usr/bin/env bash
# Funções para capturar telas do Aura Beta já mascaradas. Carregar com:
#   source ~/Projects/agent-scripts/skills/aura-novidades/scripts/aura-novidades-capturar
# Depois:
#   nov_login /product-assortment          # abre sessão isolada, autentica por token, viewport 1440×900
#   ... interações com agent-browser ...
#   nov_shot novidades/entradas/img/x.png  # mascara, verifica e captura (falha se restar dado sensível)
#   nov_fim                                # fecha a sessão
# Nunca imprime token, senha ou a URL de bootstrap.
set -o pipefail

NOV_RAIZ="${AURA_BETA_ROOT:-$HOME/Projects/beta}"
NOV_SKILL="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NOV_UI="${NOV_UI:-https://ui.beta.aura.localhost}"
NOV_API="${NOV_API:-https://api.beta.aura.localhost}"
NOV_CNPJ="${NOV_CNPJ:-05101867000157}"
NOV_MASCARA="$NOV_SKILL/mascara.js"

nov_login() {
  local rota="${1:-/product-assortment}"
  export AGENT_BROWSER_SESSION="$(agent-browser session id --scope worktree --prefix novidades)"
  local token
  token="$(BETA_API_URL="$NOV_API" "$NOV_RAIZ/scripts/beta-api-token.sh")" || { echo "nov_login: falha ao obter token" >&2; return 1; }
  if ! agent-browser --allowed-domains "${NOV_UI#https://},${NOV_API#https://}" \
    open "$NOV_UI/login?token=${token}&cnpj=${NOV_CNPJ}&redirect_uri=${rota}" >/dev/null 2>&1; then
    unset token
    nov_fim
    return 1
  fi
  unset token
  agent-browser set viewport 1440 900 >/dev/null
  if ! agent-browser wait --url "$NOV_UI$rota*" >/dev/null || ! agent-browser wait --fn "document.readyState === 'complete' && !location.search.includes('token=') && document.body.innerText.trim().length > 0" >/dev/null; then
    nov_fim
    return 1
  fi
  local url
  url="$(agent-browser get url)"
  case "$url" in
    *token=*) echo "nov_login: bootstrap não concluiu (URL ainda com token)" >&2; return 1 ;;
  esac
  echo "nov_login: $url"
}

# Mascara e verifica; só captura quando nada sensível restou.
nov_shot() {
  local destino="$1"
  [ -n "$destino" ] || { echo "nov_shot: informe o arquivo de destino" >&2; return 1; }
  local resultado
  resultado="$(agent-browser eval --stdin < "$NOV_MASCARA")" || return 1
  if ! printf '%s' "$resultado" | python3 -c 'import json,sys; v=json.load(sys.stdin); v=json.loads(v) if isinstance(v,str) else v; sys.exit(0 if isinstance(v,dict) and v.get("restos")==[] else 1)'; then
    echo "nov_shot: máscara não validada; captura cancelada" >&2
    return 1
  fi
  agent-browser screenshot "$destino" >/dev/null || return 1
  echo "nov_shot: $destino (máscara verificada)"
}

nov_fim() {
  agent-browser close >/dev/null 2>&1 || true
  unset AGENT_BROWSER_SESSION
}
