#!/usr/bin/env bash
# Vinheta dos vídeos de novidade: abertura (logo animado + quadro com o título) e encerramento, do
# modelo aitrus/marca/modelos/video-quadros.html. Parâmetros em novidades/vinheta.json; desenho em
# novidades/vinheta/vinheta.html; marca (tokens, fontes, logo) lida de aitrus/marca/.
#
#   aura-novidades-vinheta --simular [slug]        serve a vinheta e imprime as URLs para ver no browser
#                                                  (Ctrl-C encerra)
#   aura-novidades-vinheta --render <slug> <dir>   renderiza abertura.mp4 e encerramento.mp4 (30 fps) em <dir>,
#                                                  quadro a quadro a partir da animação CSS, mais logo-sonoro.wav
#
# Renderização: a página abre com render=1 (animações pausadas), o script fixa cada instante com
# Vinheta.quadro(t) e tira um screenshot; o ffmpeg monta os quadros. A página é servida por HTTP
# local com a raiz em aitrus/, porque por file:// o Chrome não carrega as fontes da marca.
# Raiz das novidades: AURA_NOVIDADES_ROOT (padrão ~/Projects/context/aitrus/novidades).
set -euo pipefail
nov="${AURA_NOVIDADES_ROOT:-$HOME/Projects/context/aitrus/novidades}"
aitrus="$(cd "$nov/.." && pwd)"
cfg="$nov/vinheta.json"
[ -f "$cfg" ] || { echo "config não encontrada: $cfg" >&2; exit 2; }
[ -f "$nov/vinheta/vinheta.html" ] || { echo "modelo não encontrado: $nov/vinheta/vinheta.html" >&2; exit 2; }
[ -f "$aitrus/marca/tokens.css" ] || { echo "marca não encontrada: $aitrus/marca/tokens.css" >&2; exit 2; }

modo="${1:-}"; slug="${2:-}"; destino="${3:-}"

# ---- parâmetros (config + entrada opcional), já codificados para a query string
eval "$(python3 - "$cfg" "$nov" "$slug" <<'EOF'
import json, re, shlex, sys, urllib.parse
cfg = json.load(open(sys.argv[1], encoding='utf-8')); nov = sys.argv[2]; slug = sys.argv[3]
# nomes das áreas: os mesmos de AREAS em build.mjs
areas = json.load(open(f'{nov}/areas.json', encoding='utf-8'))
titulo, area, data_ext = 'Título da novidade', 'Mix de Produtos', '2 de setembro de 2026'
if slug:
    t = open(f'{nov}/entradas/{slug}.md', encoding='utf-8').read()
    m = re.match(r'^---\n(.*?)\n---', t, re.S); meta = {}
    for l in m.group(1).split('\n'):
        if ':' in l: k, v = l.split(':', 1); meta[k.strip()] = re.sub(r'\s+#.*$', '', v).strip()
    meses = ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro']
    y, mo, da = meta['data'].split('-'); titulo = meta['titulo']; area = areas.get(meta.get('area', ''), ''); data_ext = f"{int(da)} de {meses[int(mo)-1]} de {y}"
dur = cfg['duracaoSegundos']; vd = cfg.get('video', {}); som = cfg.get('som', {})
enc = lambda **kw: urllib.parse.urlencode(kw, quote_via=urllib.parse.quote)
q = shlex.quote
print('AB_DUR=' + q(str(dur['abertura']))); print('EN_DUR=' + q(str(dur['encerramento']))); print('FPS=' + q(str(cfg.get('quadrosPorSegundo', 30))))
print('AB_Q=' + q(enc(tipo='abertura', titulo=titulo, area=area, data=data_ext, rotulo=cfg['abertura']['rotulo'])))
print('EN_Q=' + q(enc(tipo='encerramento', texto=cfg['encerramento']['texto'])))
print('OUT_W=' + q(str(vd.get('largura', 1440)))); print('OUT_H=' + q(str(vd.get('altura', 900)))); print('ESCALA=' + q(str(vd.get('escala', 1))))
print('LOGO_SONORO=' + q('1' if som.get('logoSonoro') else '0')); print('LOGO_ARQ=' + q(som.get('logo') or ''))
EOF
)"

# ---- servidor HTTP local (só 127.0.0.1), com a raiz em aitrus/
porta="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')"
python3 -m http.server "$porta" --bind 127.0.0.1 --directory "$aitrus" >/dev/null 2>&1 &
servidor=$!
encerrar() { kill "$servidor" 2>/dev/null || true; }
trap encerrar EXIT
for _ in $(seq 50); do curl -s -o /dev/null "http://127.0.0.1:$porta/marca/tokens.css" && break; sleep 0.1; done
base="http://127.0.0.1:$porta/novidades/vinheta/vinheta.html"

case "$modo" in
--simular)
  echo "abertura:     $base?$AB_Q&autoplay=1"
  echo "encerramento: $base?$EN_Q&autoplay=1"
  echo "(recarregue para repetir; Ctrl-C encerra)"
  wait "$servidor"
  ;;
--render)
  [ -n "$slug" ] && [ -n "$destino" ] || { echo "uso: aura-novidades-vinheta --render <slug> <dir>" >&2; exit 2; }
  mkdir -p "$destino"
  export AGENT_BROWSER_SESSION="$(agent-browser session id --scope worktree --prefix "novidades-vinheta-$$")"
  trap 'agent-browser close >/dev/null 2>&1 || true; encerrar' EXIT
  for tipo in abertura encerramento; do
    if [ "$tipo" = abertura ]; then dur="$AB_DUR"; consulta="$AB_Q"; else dur="$EN_DUR"; consulta="$EN_Q"; fi
    total="$(python3 -c "print(int(round($dur*$FPS)))")"
    quadros="$(mktemp -d "$destino/quadros-$tipo.XXXXXX")"
    agent-browser set viewport "$OUT_W" "$OUT_H" "$ESCALA" >/dev/null
    agent-browser open "$base?$consulta&render=1" >/dev/null 2>&1
    agent-browser wait --fn "document.documentElement.dataset.pronto === '1'" >/dev/null
    tempos="$(python3 -c "print(' '.join(str(i/$FPS) for i in range($total)))")"
    i=0
    for t in $tempos; do
      agent-browser eval "window.Vinheta.quadro($t)" >/dev/null
      agent-browser screenshot "$(printf '%s/q%04d.png' "$quadros" "$i")" >/dev/null
      i=$((i+1))
    done
    ffmpeg -v error -y -framerate "$FPS" -i "$quadros/q%04d.png" -vf "scale=$OUT_W:$OUT_H:flags=lanczos" -c:v libx264 -preset medium -crf 20 -pix_fmt yuv420p "$destino/$tipo.mp4"
    echo "vinheta $tipo: $destino/$tipo.mp4 ($total quadros, ${dur}s)"
  done
  agent-browser close >/dev/null 2>&1 || true
  if [ "$LOGO_SONORO" = 1 ]; then
    [ -n "$LOGO_ARQ" ] && [ -f "$nov/$LOGO_ARQ" ] || { echo "logo sonoro ligado, mas som.logo não existe: $nov/$LOGO_ARQ" >&2; exit 2; }
    ffmpeg -v error -y -i "$nov/$LOGO_ARQ" -ar 48000 -ac 2 "$destino/logo-sonoro.wav"
    echo "logo sonoro: $destino/logo-sonoro.wav (de $LOGO_ARQ)"
  fi
  ;;
*) echo "uso: aura-novidades-vinheta --simular [slug] | --render <slug> <dir>" >&2; exit 2 ;;
esac
