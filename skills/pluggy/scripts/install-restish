#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
state="$root/.state/pluggy"
[[ "$(uname -s)/$(uname -m)" == "Linux/x86_64" ]] || {
  echo 'Instalador preparado para Linux x86_64 (WSL). Consulte rest.sh para outra plataforma.' >&2
  exit 1
}
mkdir -p "$state"
chmod 700 "$state"
curl -4 --fail --location --silent --show-error --connect-timeout 15 --max-time 120 \
  https://github.com/rest-sh/restish/releases/download/v2.3.0/restish-2.3.0-linux-amd64.tar.gz \
  --output "$state/restish.tar.gz"
printf '%s  %s\n' '5de24353560597562ffc99799ea79a0cd22c5f3cabbb3ffba3ff5e9b97473357' \
  "$state/restish.tar.gz" | sha256sum --check
tar -xzf "$state/restish.tar.gz" -C "$state" restish
chmod 700 "$state/restish"
python3 "$root/skills/pluggy/scripts/restish_bridge.py" setup
